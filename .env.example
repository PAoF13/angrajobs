# Public Supabase values. Keep the URL available for future browser-safe features.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Never prefix these with NEXT_PUBLIC and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
RATE_LIMIT_HASH_SALT=GENERATE_A_LONG_RANDOM_SECRET

# Optional social/contact URLs used by CTA buttons.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/YOUR_PROFILE
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@YOUR_PROFILE
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/55XXXXXXXXXXX

# Optional anti-bot. Configure BOTH variables together in production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
